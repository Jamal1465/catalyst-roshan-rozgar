{
  "name": "roshan-rozgar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "e2e:demo": "node --env-file-if-exists=.env scripts/e2e-demo.mjs",
    "audit:endpoints": "node scripts/endpoint-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.71.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
